# TFNK™ Environment Variables
# Copy this file to .env and fill in your values.

# ── AI / LLM ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Google APIs ───────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ── Finance ───────────────────────────────────────────────────────────────────
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

# ── Media ─────────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=

# ── Network / Mobile ──────────────────────────────────────────────────────────
TAILSCALE_AUTH_KEY=
MOBILE_AUTH_TOKEN=tfnk-mobile-token-change-me

# ── Directories ───────────────────────────────────────────────────────────────
BACKUP_DIR=./backups
LOG_DIR=./logs
MEMORY_DIR=./memory
SKILLS_DIR=./skills

# ── Agent ─────────────────────────────────────────────────────────────────────
# basic | thinking | collaborative
AGENT_MODE=basic

# Comma-separated absolute paths that the agent cannot modify
LOCK_LIST=

# Tool policies: allow | deny | confirm
TOOL_POLICY_WEB_SEARCH=allow
TOOL_POLICY_READ_FILE=allow
TOOL_POLICY_WRITE_FILE=confirm
TOOL_POLICY_DELETE_FILE=confirm
TOOL_POLICY_RUN_CODE=confirm
TOOL_POLICY_SYSTEM_COMMAND=confirm
TOOL_POLICY_BROWSER_ACTION=allow

# ── Ollama (local models) ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false
